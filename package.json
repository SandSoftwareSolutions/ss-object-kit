{
  "name": "@sandsoftwaresolutions/object-kit",
  "version": "0.1.1",
  "description": "Object and list helpers by path, merge, group, sort and flatten. Safe against prototype pollution.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "object",
    "path",
    "merge",
    "groupby",
    "sortby",
    "pollution"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-object-kit.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-object-kit/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-object-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
